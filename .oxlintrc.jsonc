{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "oxc",
    "import",
    "jsdoc",
    "jsx-a11y",
    "node",
    "vitest",
  ],
  "options": {
    "typeAware": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
  },
  "rules": {
    "react/react-in-jsx-scope": "off", // React 17+では不要
    "import/no-unassigned-import": "off",
    "import/no-absolute-path": "off",
    "jsx-a11y/control-has-associated-label": "off", // eslint-plugin-jsx-a11y の recommended ではないため無効化
    "jsx-a11y/prefer-tag-over-role": "off", // eslint-plugin-jsx-a11y の recommended ではないため無効化
    "react/no-unstable-nested-components": "off", // eslint-plugin-react の recommended ではないため無効化
    "unicorn/consistent-function-scoping": "off", // eslint-plugin-unicorn の recommended ではないため無効化
    "typescript/no-explicit-any": "error",
    "typescript/no-deprecated": "error", // 非推奨APIの使用を型情報から検出する
  },
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": "as",
      "components": {},
      "attributes": {},
    },
    "next": {
      "rootDir": [],
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": "19.3.1",
      "componentWrapperFunctions": [],
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {},
    },
    "vitest": {
      "typecheck": false,
    },
  },
  "env": {
    "builtin": true,
  },
  "globals": {},
}
